{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadBucket",
      "Effect": "Allow",
      "Action": ["s3:GetBucketTagging", "s3:GetBucketPublicAccessBlock"],
      "Resource": "arn:aws:s3:::ag-demo-*"
    },
    {
      "Sid": "RestorePublicAccessBlock",
      "Effect": "Allow",
      "Action": ["s3:PutBucketPublicAccessBlock"],
      "Resource": "arn:aws:s3:::ag-demo-*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/auto-remediate": "true"
        }
      }
    }
  ]
}
